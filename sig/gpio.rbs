# @sidebar io_peripheral

type gpio_pin_t = (Integer|String|Symbol)

class GPIO

  # @sidebar error
  class Error
    GPIO_ERROR_NONE:           0
    GPIO_ERROR_TIMEOUT:       -1
    GPIO_ERROR_GENERIC:       -2
    GPIO_ERROR_NO_DATA:       -3
    GPIO_ERROR_NOT_PERMITTED: -4
    GPIO_ERROR_INVALID_ARG:   -5
    GPIO_ERROR_IO:            -6

    def self.peripheral_error: (Integer code, ?String name) -> void
  end

  IN:          1 # 0b0000001
  OUT:         2 # 0b0000010
  HIGH_Z:      4 # 0b0000100
  PULL_UP:     8 # 0b0001000
  PULL_DOWN:  16 # 0b0010000
  OPEN_DRAIN: 32 # 0b0100000
  ALT:        64 # 0b1000000

  type gpio_logic_t = (0 | 1)

  attr_reader pin: gpio_pin_t

  @dir: (Integer|nil)
  @alt_function: (Integer|nil)
  @pull: (Integer|nil)
  @open_drain: bool

  # Ruby method
  def initialize: (gpio_pin_t pin, Integer flags, ?Integer alt_function) -> void
  def setmode: (Integer flags, ?Integer alt_function) -> 0

  # C function
  def self.read_at: (gpio_pin_t pin) -> gpio_logic_t
  def self.high_at?: (gpio_pin_t pin) -> bool
  def self.low_at?: (Integer) -> bool
  def self.write_at: (gpio_pin_t pin, Integer value) -> 0
  def read: () -> gpio_logic_t
  def write: (Integer value) -> 0
  def high?: () -> bool
  def low?: () -> bool

  def set_function: (Integer flags, Integer alt_function) -> 0
  def set_dir: (Integer flags) -> 0
  def set_pull: (Integer flags) -> 0
  def open_drain: (Integer flags) -> 0
  private def on_initialize?: () -> bool
  private def _init: (gpio_pin_t pin) -> 0
  def self.set_function_at: (gpio_pin_t pin, Integer alt_function) -> 0
  def self.set_dir_at: (gpio_pin_t pin, Integer flags) -> 0
  def self.pull_up_at: (gpio_pin_t pin) -> 0
  def self.pull_down_at: (gpio_pin_t pin) -> 0
  def self.open_drain_at: (gpio_pin_t pin) -> 0
end


class GPIO
  # Check if GPIO pin is HIGH
  def high?: () -> bool

  # Check if GPIO pin is LOW
  def low?: () -> bool

  # Set to open drain output mode
  def open_drain: (Integer flags) -> Integer

  # Read GPIO pin state
  def read: () -> Integer

  # Write value to GPIO pin
  def write: (Integer value) -> Integer

  # Check if specified pin is HIGH
  def self.high_at?: ((Integer | String | Symbol) pin) -> bool

  # Check if specified pin is LOW
  def self.low_at?: ((Integer | String | Symbol) pin) -> bool

  # Create GPIO object
  def self.new: ((Integer | String | Symbol) pin, Integer flags, ?Integer alt_function) -> GPIO

  # Set specified pin to open drain output mode
  def self.open_drain_at: ((Integer | String | Symbol) pin) -> Integer

  # Set specified pin to pull-down
  def self.pull_down_at: ((Integer | String | Symbol) pin) -> Integer

  # Set specified pin to pull-up
  def self.pull_up_at: ((Integer | String | Symbol) pin) -> Integer

  # Read specified pin state
  def self.read_at: ((Integer | String | Symbol) pin) -> Integer

  # Set input/output direction of specified pin
  def self.set_dir_at: ((Integer | String | Symbol) pin, Integer flags) -> Integer

  # Set function of specified pin
  def self.set_function_at: ((Integer | String | Symbol) pin, Integer alt_function) -> Integer

  # Write value to specified pin
  def self.write_at: ((Integer | String | Symbol) pin, Integer value) -> Integer

end
